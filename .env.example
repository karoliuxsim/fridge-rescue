# Copy to .env.local and fill in the Supabase project settings.
# Only use a Publishable key, never a Secret or service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

GEMINI_API_KEY=

AI_RECIPE_SIGNING_SECRET=

# Server only. Required HTTPS origin in production; development defaults to localhost:3001.
APP_URL=
# Server only. AI (including prompt preview) returns 503 until Redis is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
